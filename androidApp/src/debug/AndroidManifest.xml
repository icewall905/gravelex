<?xml version="1.0" encoding="utf-8"?>
<!--
    Fork: debug-only additions. This overlay is merged into debug builds
    only; release builds never see these elements.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        The suffixed debug app installs beside a differently signed Gravel, so it
        must not redefine the PebbleKit 2 permissions (the installer rejects a
        permission already owned by another signer) or claim the fixed basalt
        authority (one owner per authority). The basalt provider stays declared
        because PebbleKitComponentState toggles it by class name.
    -->
    <permission android:name="io.rebble.pebblekit2.permission.SEND_DATA_TO_WATCH" tools:node="remove" />
    <permission android:name="io.rebble.pebblekit2.permission.RECEIVE_DATA_FROM_WATCH" tools:node="remove" />
    <permission android:name="io.rebble.pebblekit2.permission.READ_PROVIDER" tools:node="remove" />
    <application>
        <provider
            android:name="io.rebble.libpebblecommon.pebblekit.classic.PebbleKitProvider"
            android:authorities="${applicationId}.basalt"
            tools:replace="android:authorities" />
        <!--
            Sets the dictation debug hooks from adb (see SttDebugReceiver);
            the DUMP gate is described with the other adb receivers in
            DESIGN_NOTES.
        -->
        <receiver
            android:name="coredevices.coreapp.debug.SttDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="coredevices.coreapp.SET_STT_DEBUG" />
            </intent-filter>
        </receiver>
        <!-- Drives the Notebook from adb: arms reminders, queues and drains captures (see NotebookDebugReceiver); same DUMP gate. -->
        <receiver
            android:name="com.anopticlabs.gravel.debug.NotebookDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.anopticlabs.gravel.notebook.DEBUG_REMINDER" />
            </intent-filter>
        </receiver>
        <!-- The Compose UI tests' host activity, which ui-test-manifest exports; the tests start it from inside the app. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            tools:replace="android:exported" />
    </application>
</manifest>
