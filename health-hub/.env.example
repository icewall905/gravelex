# Copy using scripts/init-env.sh, which generates AUTH_TOKEN locally.
AUTH_TOKEN=
BIND_ADDRESS=127.0.0.1
WEB_PORT=8790
RECEIVER_PORT=9998
PUBLIC_URL=
SOURCE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
PEBBLE_TZ=UTC
WEARER_NAME=
LOG_LEVEL=INFO
# Optional Home Assistant integration WebSocket forwarding:
HA_WS_URL=
HA_TOKEN=
HA_REPORT_SERVICE=
# Optional MQTT discovery:
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
DISCOVERY_PREFIX=homeassistant
# Optional external weight/profile database (read-only credentials):
WEIGHT_PG_DSN=
WEIGHT_PG_QUERY=
PROFILE_PG_QUERY=
# Optional existing Health dashboard scale API:
HEALTH_DASHBOARD_URL=
HEALTH_SCALE_USER=
# Optional OpenAI-compatible LLM endpoint, including local servers:
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
BRIEFING_TIME=05:00,05:40

# No default stillness threshold: see MOTION-CALIBRATION.md before enabling.
HRV_MOTION_POLICIES=[]

# Daily guidance from stock pulse/sleep/training; strict_hrv restores the older HRV-only model.
RECOVERY_MODE=stock_firmware

# Dashboard bootstrap only; later resets target the household registry.
PH_ADMIN_USERNAME=admin
PH_PASSWORD_HASH=
PH_SESSION_SECRET=
