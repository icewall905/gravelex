{
  "name": "ha-health-sync",
  "author": "self-hosted",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "HA Health Sync",
    "uuid": "b41d5c42-8f24-4229-93dd-828ad2218452",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
